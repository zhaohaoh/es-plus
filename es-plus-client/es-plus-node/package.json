{
  "name": "es-plus-node",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "esbuild src/app.ts src/server.ts --bundle --platform=node --format=esm --target=node22 --outdir=dist",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "start": "node dist/app.js",
    "dev": "node --experimental-strip-types src/app.ts"
  },
  "dependencies": {
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.9"
  }
}
